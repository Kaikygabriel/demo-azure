@page "/Login"
@inherits LoginPage
<PageTitle>Login</PageTitle>

<MudText Typo="Typo.h3" Align="Align.Center" Class="mt-12 mb-10">Login</MudText>
<MudGrid Justify="Justify.Center">
    <MudItem xs="11" sm="9">
        @if (Request is null && Error is null)
        {
            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
                <MudProgressCircular Indeterminate="true"/>
            </MudStack>
        }
        else if(Error is not null)
        {
            <MudAlert  >@Error.Message</MudAlert>
        }
        else
        {

            <MudPaper Class="pa-3">
                <EditForm Model="@Request" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator/>
                    <MudTextField
                        @bind-Value="Request.Email"
                        MaxLength="300"
                        For="@(() => Request.Email)"
                        InputType="InputType.Email"
                        AutoFocus="true"
                        Required="true"
                        RequiredError="Email is required!"
                        HelperText="Insert a email valid!"
                        Label="Email"/>
                    <MudTextField
                        @bind-Value="Request.Password"
                        MaxLength="120"
                        For="@(() => Request.Password)"
                        InputType="InputType.Password"
                        Required="true"
                        RequiredError="Password is required!"
                        HelperText="Insert a password valid!"
                        Label="Password"/>

                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-5">
                        @if (!Loading)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 70%" Size="Size.Large" Class="w-100" ButtonType="ButtonType.Submit">Login</MudButton>
                        }
                        else
                        {
                            <MudSkeleton Height="42.45" Style="width: 70%"/>
                        }
                    </MudStack>

                </EditForm>
            </MudPaper>
        }
    </MudItem>
</MudGrid>
