
@if (_shoppingCartDto is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="shopping-cart">

        <div class="cart-header">
            <MudText Typo="Typo.h6">
                Meu carrinho
            </MudText>
            <MudDivider />
        </div>

        @if (!_shoppingCartDto.Orders.Any())
        {
            <div class="cart-empty">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                         Size="Size.Large" />
                <MudText Typo="Typo.body2">
                    Seu carrinho está vazio.
                </MudText>
            </div>
        }
        else
        {
            <div class="cart-items">
                @foreach (var order in _shoppingCartDto.Orders)
                {
                    <MudCard Class="cart-item" Elevation="0">

                        <MudCardMedia Image="@order.Product.ImageThumb"
                                      Class="cart-item-image" />

                        <div class="cart-item-details">
                            <MudCardContent Class="cart-item-content">

                                <MudText Typo="Typo.subtitle2"
                                         Class="cart-item-title">
                                    @order.Product.Title
                                </MudText>

                                <MudStack Row="true"
                                          AlignItems="AlignItems.Center"
                                          Spacing="1"
                                          Class="cart-item-rating">
                                    <MudRating Disabled="true"
                                               SelectedValue="@order.Product.Stars"
                                               Color="Color.Warning"
                                               Size="Size.Small" />
                                </MudStack>

                                <MudText Typo="Typo.subtitle1"
                                         Class="cart-item-price">
                                    @order.Total().ToString("C")
                                </MudText>

                            </MudCardContent>
                        </div>

                    </MudCard>
                }
            </div>

            <div class="cart-footer">
                <MudDivider />

                <div class="cart-total">
                    <MudText Typo="Typo.subtitle1">
                        Total
                    </MudText>

                    <MudText Typo="Typo.h6">
                        @(_shoppingCartDto.Orders.Sum(order => order.Total()).ToString("C"))
                    </MudText>
                </div>

                <MudButton FullWidth="true"
                           Size="Size.Large"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Finalizar compra
                </MudButton>
            </div>
        }
    </div>
}
