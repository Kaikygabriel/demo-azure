<MudNavMenu>
        @foreach (var order in _shoppingCartDto.Orders)
        {
            <MudItem xs="12" sm="9" md="4" lg="3" xl="2"
                     Class="product-item">

                <MudCard Class="product-card" Elevation="1">
                    <MudCardMedia Image="@order.Product.ImageThumbUrl"
                                  Class="product-image" />

                    <div class="product-details">
                        <MudCardContent Class="product-content">
                            <MudText Typo="Typo.subtitle1"
                                     Class="product-title">
                                @order.Product.Title
                            </MudText>
                            <MudText Typo="Typo.subtitle1"
                                     Class="product-title">
                                @order.Product.Summary
                            </MudText>

                            <MudStack Row="true"
                                      AlignItems="AlignItems.Center"
                                      Spacing="1"
                                      Class="product-rating">
                                <MudRating Disabled="true"
                                           SelectedValue="@order.Product.Stars"
                                           Color="Color.Primary"
                                           Size="Size.Small" />

                                <MudText Typo="Typo.caption">
                                    (@order.Product.Comments.Count)
                                </MudText>
                            </MudStack>

                            <MudText Typo="Typo.h6"
                                     Class="product-price">
                                @order.Total().ToString("C")
                            </MudText>
                        </MudCardContent>
                        </div>
                </MudCard>
            </MudItem>
        }
</MudNavMenu>